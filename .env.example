# Copy to .env and fill in your own values:
#   cp .env.example .env
#
# GMAIL_USER is the account send-invoice-email.js authenticates as.
#
# GMAIL_APP_PASSWORD is a Gmail "App Password", NOT your regular password:
#   1. Enable 2-Step Verification on the account (if not already):
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:
#      https://myaccount.google.com/apppasswords
#      (App name doesn't matter, e.g. "invoicer")
#   3. Paste the generated 16-character password below (spaces don't matter)

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
